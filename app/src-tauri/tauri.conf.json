{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YTDownload",
  "version": "0.1.0",
  "identifier": "com.adrianrabelo.ytdownload",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YTDownload",
        "width": 980,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https://i.ytimg.com https://*.ggpht.com https://*.googleusercontent.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Utility",
    "shortDescription": "Baixa vídeos e músicas do YouTube",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  }
}